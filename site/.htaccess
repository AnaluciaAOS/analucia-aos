# No folder listings, and two safe headers (ORD-0025). The HTTPS redirect is in docs/SITE-DEPLOY.md:
# enable it only after the certificate shows.
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
