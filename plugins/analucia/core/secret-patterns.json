{
  "$comment": "SPEC-0004 §5: patterns that aos check-push refuses in added lines of pushed commits (E_SECRET). Messages name the file, the line and the pattern, never the value.",
  "github_token": {
    "description": "GitHub token (personal, OAuth, user-to-server, server-to-server, refresh)",
    "pattern": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}\\b"
  },
  "github_fine_grained_pat": {
    "description": "GitHub fine-grained personal access token",
    "pattern": "\\bgithub_pat_[A-Za-z0-9_]{50,}\\b"
  },
  "anthropic_api_key": {
    "description": "Anthropic API key",
    "pattern": "\\bsk-ant-[A-Za-z0-9_-]{20,}"
  },
  "aws_access_key_id": {
    "description": "AWS access key ID",
    "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b"
  },
  "private_key_block": {
    "description": "PEM private key block",
    "pattern": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----"
  },
  "resend_api_key": {
    "description": "Resend API key",
    "pattern": "\\bre_[A-Za-z0-9]{8}_[A-Za-z0-9]{24,}\\b"
  }
}
